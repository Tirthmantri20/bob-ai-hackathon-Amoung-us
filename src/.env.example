# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./supply_chain.db

# IBM watsonx / Bob AI Configuration
WATSONX_APIKEY=your-watsonx-apikey-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite model identifier — do not hard-code in application logic
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
IBM_BOB_API_KEY=your-ibm-bob-api-key-here

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_TRANSPORT=sse

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here
